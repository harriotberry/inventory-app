# Copy this file to .env for local development
# Never commit .env to GitHub — it contains secrets

# From Mailgun dashboard → Webhooks → HTTP webhook signing key
MAILGUN_SIGNING_KEY=your-mailgun-signing-key-here

# Added automatically by Vercel when you connect Blob storage
# You only need this locally — copy it from Vercel dashboard → Storage → your blob store → .env.local
BLOB_READ_WRITE_TOKEN=your-blob-token-here
